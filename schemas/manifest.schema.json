{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svwbdata:schema:manifest:v1",
  "title": "SVWBData snapshot manifest",
  "type": "object",
  "required": ["schema_version", "snapshot", "totals", "files"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "date",
        "package_name",
        "apk_version_name",
        "apk_version_code",
        "unity_version",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "apk_version_name": { "type": "string", "minLength": 1 },
        "apk_version_code": { "type": "integer", "minimum": 0 },
        "unity_version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["files", "bytes", "language_tables", "localized_entries"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "language_tables": { "type": "integer", "minimum": 0 },
        "localized_entries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "root_key", "languages"],
        "properties": {
          "path": { "type": "string", "pattern": "^data/texts/extracted/[^/]+\\.json$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "root_key": { "enum": ["cardnametext", "cardtext", "skilldesctext"] },
          "languages": {
            "type": "object",
            "propertyNames": {
              "enum": ["Jpn", "Eng", "Chs", "Kor", "Cht", "Fre", "Ita", "Ger", "Spa"]
            },
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
